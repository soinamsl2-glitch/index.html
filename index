<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0f172a">
<title>OmniSearch — Hệ Thống Tìm Kiếm Hình Ảnh Đa Nền Tảng</title>
<style>
:root {
  --bg: #0f172a;
  --card-bg: #1e293b;
  --primary: #3b82f6;
  --primary-hover: #2563eb;
  --text: #f8fafc;
  --text-muted: #94a3b8;
  --border: #334155;
  --accent: #10b981;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background-color: var(--bg);
  color: var(--text);
  line-height: 1.5;
  padding-bottom: 40px;
}

header {
  background: var(--card-bg);
  border-bottom: 1px solid var(--border);
  padding: 24px 0;
  text-align: center;
}
header h1 { font-size: 26px; font-weight: 700; color: var(--text); }
header p { font-size: 14px; color: var(--text-muted); margin-top: 4px; }

.container { max-width: 900px; margin: 24px auto; padding: 0 16px; }

.card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 20px;
}

.drop-zone {
  border: 2px dashed var(--border);
  border-radius: 8px;
  padding: 36px 20px;
  text-align: center;
  cursor: pointer;
  transition: 0.2s;
  background: rgba(255, 255, 255, 0.02);
  display: block;
}
.drop-zone:hover { border-color: var(--primary); background: rgba(59, 130, 246, 0.05); }

.preview-container {
  display: none;
  align-items: center;
  gap: 16px;
  margin-top: 16px;
  background: rgba(0,0,0,0.2);
  padding: 12px 16px;
  border-radius: 8px;
}
.preview-container img {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 6px;
  border: 1px solid var(--border);
}

.engine-selector {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 10px;
  margin: 16px 0;
}
.engine-checkbox {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  background: rgba(255, 255, 255, 0.03);
  padding: 10px 12px;
  border-radius: 6px;
  border: 1px solid var(--border);
  cursor: pointer;
}

.btn {
  width: 100%;
  padding: 12px;
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
  transition: 0.2s;
}
.btn:hover { background: var(--primary-hover); }
.btn-secondary {
  background: #475569;
  padding: 6px 12px;
  font-size: 12px;
  width: auto;
  margin-top: 6px;
}

.results-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 16px;
  margin-top: 16px;
}
.result-item {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.result-item img { width: 100%; height: 140px; object-fit: cover; }
.result-content { padding: 12px; flex: 1; display: flex; flex-direction: column; }
.result-source { font-size: 11px; font-weight: 700; color: var(--accent); text-transform: uppercase; }
.result-title { font-size: 13px; margin: 6px 0; color: var(--text); flex: 1; }
.result-link { font-size: 12px; color: var(--primary); text-decoration: none; font-weight: 600; }

.loading { display: none; text-align: center; padding: 20px; color: var(--text-muted); }
</style>
</head>
<body>

<header>
  <h1>OmniSearch Engine</h1>
  <p>Hệ thống hỗ trợ tìm kiếm hình ảnh & thông tin đa nền tảng</p>
</header>

<div class="container">
  <div class="card">
    <label class="drop-zone" for="fileInput" id="dropZone">
      <div style="font-size: 36px; margin-bottom: 8px;">📷</div>
      <p><b>Kéo thả ảnh vào đây</b> hoặc nhấp để tải ảnh lên</p>
      <span style="font-size: 12px; color: var(--text-muted);">Hỗ trợ định dạng JPG, PNG, WEBP</span>
    </label>
    <input type="file" id="fileInput" accept="image/jpeg, image/png, image/webp" style="display:none">

    <div class="preview-container" id="previewArea">
      <img id="imagePreview" src="" alt="Preview">
      <div>
        <p id="fileName" style="font-weight: 600; font-size: 14px;"></p>
        <p id="fileSize" style="font-size: 12px; color: var(--text-muted);"></p>
        <button class="btn btn-secondary" id="resetBtn">Chọn ảnh khác</button>
      </div>
    </div>

    <p style="font-size: 14px; margin-top: 18px; font-weight: 600;">Nguồn dữ liệu truy quét:</p>
    <div class="engine-selector">
      <label class="engine-checkbox"><input type="checkbox" checked value="lens"> Google Lens</label>
      <label class="engine-checkbox"><input type="checkbox" checked value="bing"> Bing Visual Search</label>
      <label class="engine-checkbox"><input type="checkbox" checked value="social"> Social Monitor</label>
    </div>

    <button class="btn" id="searchBtn">Bắt đầu quét & tìm kiếm</button>
  </div>

  <div class="card" id="resultsSection" style="display:none;">
    <h3 style="font-size: 18px;">Kết quả tìm kiếm</h3>
    <div class="loading" id="loading">⏳ Đang xử lý dữ liệu và gửi yêu cầu tới các API...</div>
    <div class="results-grid" id="resultsGrid"></div>
  </div>
</div>

<script>
let currentFile = null;

const fileInput = document.getElementById('fileInput');
const dropZone = document.getElementById('dropZone');
const previewArea = document.getElementById('previewArea');
const imagePreview = document.getElementById('imagePreview');
const searchBtn = document.getElementById('searchBtn');
const resetBtn = document.getElementById('resetBtn');

fileInput.addEventListener('change', (e) => handleFile(e.target.files[0]));
dropZone.addEventListener('dragover', (e) => e.preventDefault());
dropZone.addEventListener('drop', (e) => {
  e.preventDefault();
  handleFile(e.dataTransfer.files[0]);
});

resetBtn.addEventListener('click', () => {
  currentFile = null;
  fileInput.value = '';
  previewArea.style.display = 'none';
  dropZone.style.display = 'block';
  document.getElementById('resultsSection').style.display = 'none';
});

function handleFile(file) {
  if (!file) return;
  if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
    alert('Vui lòng chọn định dạng ảnh JPG, PNG hoặc WEBP.');
    return;
  }
  currentFile = file;
  imagePreview.src = URL.createObjectURL(file);
  document.getElementById('fileName').textContent = file.name;
  document.getElementById('fileSize').textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';
  previewArea.style.display = 'flex';
  dropZone.style.display = 'none';
}

searchBtn.addEventListener('click', async () => {
  if (!currentFile) {
    alert('Vui lòng chọn hoặc tải ảnh lên trước khi tìm kiếm.');
    return;
  }

  const resultsSection = document.getElementById('resultsSection');
  const loading = document.getElementById('loading');
  const resultsGrid = document.getElementById('resultsGrid');

  resultsSection.style.display = 'block';
  loading.style.display = 'block';
  resultsGrid.innerHTML = '';

  const formData = new FormData();
  formData.append('image', currentFile);

  try {
    /* 
      Kết nối thực tế đến Backend Server:
      const response = await fetch('http://localhost:3000/api/search', {
        method: 'POST',
        body: formData
      });
      const data = await response.json();
    */

    // Mô phỏng kết quả trả về
    setTimeout(() => {
      loading.style.display = 'none';
      const mockResults = [
        { source: 'Google Lens', title: 'Ảnh tương thích trên các trang tin tức', img: imagePreview.src, link: 'https://lens.google.com' },
        { source: 'Bing Visual Search', title: 'Bài viết và hình ảnh có bố cục tương tự', img: imagePreview.src, link: 'https://bing.com/visualsearch' },
        { source: 'Social Monitor', title: 'Thông tin công khai liên quan', img: imagePreview.src, link: '#' }
      ];

      mockResults.forEach(item => {
        const itemEl = document.createElement('div');
        itemEl.className = 'result-item';
        itemEl.innerHTML = `
          <img src="${item.img}">
          <div class="result-content">
            <span class="result-source">${item.source}</span>
            <p class="result-title">${item.title}</p>
            <a href="${item.link}" target="_blank" rel="noopener noreferrer" class="result-link">Đi tới nguồn ↗</a>
          </div>
        `;
        resultsGrid.appendChild(itemEl);
      });
    }, 1500);

  } catch (error) {
    loading.textContent = 'Có lỗi xảy ra trong quá trình xử lý.';
  }
});
</script>
</body>
</html>
